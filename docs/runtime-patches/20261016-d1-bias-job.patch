+def test_d1_reference_puts_one_line_under_the_tally_and_fails_open(tmp_path, d1_bias):
+    data = tmp_path / 'data.json'; data.write_text('{}')
+    with patch.object(d1_bias, 'xau_judge', return_value=D1):
+        text, record = workflow.d1_reference(runner, data, 'daily', D1_TEXT)
+    lines = text.split('\n')
+    assert record == D1 and lines[2].startswith('- D1判定') and lines[3].startswith('- 長期にはこの後')
+    with patch.object(d1_bias, 'xau_judge', return_value=None):
+        assert workflow.d1_reference(runner, data, 'daily', D1_TEXT) == (D1_TEXT, None)
+    with patch.object(d1_bias, 'xau_judge', side_effect=RuntimeError('down')):
+        assert workflow.d1_reference(runner, data, 'daily', D1_TEXT) == (D1_TEXT, None)
