+def long_term_table_cells(source):
+    """The XAUUSD row's 大局バイアス cells of the tables under a heading containing 大局バイアス."""
+    cells, level = [], None
+    header = None
+    for line in source.splitlines():
+        heading = re.match(r'^(#{1,6})\s*(.*)$', line)
+        if heading:
+            depth = len(heading.group(1))
+            if '大局バイアス' in heading.group(2):
+                level = depth if level is None or depth <= level else level
+            elif level is not None and depth <= level:
+                level = None
+            header = None
+            continue
+        if level is None:
+            continue
